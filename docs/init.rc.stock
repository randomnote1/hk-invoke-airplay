on early-init    start ueventd    loglevel 8    mount tmpfs tmpfs /tmp size=32m    mount tmpfs tmpfs /run size=150m    symlink /run /run/run    # we already have /dev mounted    mount tmpfs tmpfs /dev remount size=4m    # set core dump size limit to unlimited    # core dump will be generated in /data/coredump/    # if the directory exists and writable    setrlimit 4  -1 -1    write /proc/sys/kernel/core_pattern "|/bin/sh /sbin/coredump.sh /data/coredump %e %p %h %s %t"    # force VM to keep 4096KB of free bytes    # default value is 2102(KB)    write /proc/sys/vm/min_free_kbytes "4096"on init    # setup the global environment    export PATH /usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/xbin:/system/usr/local/bin:/system/usr/bin:/system/bin:/system/sbin    export SECURE_USER_BUILD 0    mkdir /cache 0700 updater updater    #mkdir /data 0755 root root    mkdir /dev/shm    mount tmpfs tmpfs /dev/shm size=32m    symlink /dev/snd/timer /dev/timer    # set interface name    setprop wifi.interface wlan0    setprop ap.interface p2p0    # set AP wext private ioctl    setprop ap.bss.start_cmd bssstart    setprop ap.bss.stop_cmd bssstopon fs    exec /bin/sh /sbin/mount_partition.sh    wait /data/    # load kernel module    exec /bin/sh /usr/bin/load-kmod.sh    # create directory for share    mkdir /data/share 0755 root root    mkdir /data/misc/dhcp 0770 dhcp dhcp    mkdir /data/misc/dns 0770 root root    chown dhcp dhcp /data/misc/dhcp    # create directory for crash-dumps    mkdir /data/crash 0777 root root    # create directory for sounds of bugreport    mkdir /usr/share/sounds/bugreport 0777 root rooton post-fs    # network-related    exec /bin/ifconfig lo up    write /etc/hosts "127.0.0.1 localhost"    chmod 0644 /etc/hosts    write /proc/sys/kernel/hostname podium    mkdir /data/property 0700 root root    # use IPv6 privacy addresses    write /proc/sys/net/ipv6/conf/default/use_tempaddr "2"    write /proc/sys/net/ipv6/conf/eth0/use_tempaddr "2"    write /proc/sys/net/ipv6/conf/wlan0/use_tempaddr "2"    # set tcp socket buffer size    # only max value differs from kernel default    write /proc/sys/net/ipv4/tcp_rmem "4096 87380 2097152"    write /proc/sys/net/ipv4/tcp_wmem "4096 16384 2097152"    write /proc/sys/net/core/rmem_max "1220608"    write /proc/sys/net/core/wmem_max "1220608"# Enable ADB and ACM    write /sys/class/android_usb/android0/idProduct "0d02"    write /sys/class/android_usb/android0/iProduct "MRVL USB SDK"    write /sys/class/android_usb/android0/functions "adb"    write /sys/class/android_usb/android0/f_acm/instances "1"    write /sys/class/android_usb/android0/enable "1"    write /sys/devices/virtual/android_usb/android0/iSerial $usb_host_port_num |busybox tr -d '\n'    # create directory for wpa_supplicant    mkdir /dev/socket/wifi 0770 wifi wifi    mkdir /data/    mkdir /data/wifi 0770 wifi wifi    mkdir /data/wifi/sockets 0770 wifi wifi    mkdir /data/misc    mkdir /data/misc/dhcp    mkdir /data/misc/dns    symlink /data/wifi /var/run/wpa_supplicant    #exec /bin/sh /sbin/wpa_supplicant_setup.sh    # Enable ICMP echo for broadcast/multicast address    write /proc/sys/net/ipv4/icmp_echo_ignore_broadcasts "0"    # sntpd    mkdir /data/sntpd 0700 sntpd sntpd    # dhcpcd creates resolv.conf with wrong umask    # fill in Google DNS server in case router is not    # able to configure nameserver.    #write /etc/resolv.conf "nameserver 127.0.0.1"    chmod 0644 /etc/resolv.conf    chown dhcp dhcp /etc/resolv.conf    # set defalt timezone to US pacific    symlink /usr/share/zoneinfo/America/Los_Angeles /data/localtimeon boot    mount debugfs /sys/kernel/debug /sys/kernel/debug   # Enable heap randomization before services start    write  /proc/sys/kernel/randomize_va_space "2"    # Initialize certain properties very early so we can use them.    exec /bin/sleep 1    #start setup_partition    start firewall    start mdnsd    start sntpd    start adbd    start sshd    start iperf    start iperf_udp    start init_complete    wait /data/wifi/up    start debuggerd    wait /data/wifi/copied.conf    # this sleep is needed to wait for Kernal init    #exec /bin/sleep 6    exec /usr/bin/alsa-init.sh    exec /usr/bin/setup-dhcpserver-conf.sh    start startup_ls6    exec /bin/sleep 2    start podium    # wait for wamp services to come up before enabling service port    exec /bin/sleep 2    start serviceport    #exec /bin/LibreUID    #start net_mgr    #start unmute_audio    start boot_complete    start console    start dnscacher## Daemon processes to be run by init.# Service class names:#   onboot - services that should be started only once, on boot#   services - services which may be restarted#   <default> - oneshot services which are started explicitly (dhcpd, etc)## These class names are used by the debug script /sbin/android, to allow core# services to be bounced.service firewall /bin/logwrapper /usr/sbin/firewall.sh    user root    oneshotservice serviceport /bin/logwrapper /usr/sbin/serviceport.sh    user rootservice factory_reset /bin/sh /usr/sbin/factory-reset now    user root    oneshot    disabledservice setup_partition /bin/sh /sbin/mount_partition.sh    user root    class service    oneshotservice setup_supplicant /bin/sh /sbin/wpa_supplicant_setup.sh    user root    class service    oneshotservice ueventd /sbin/ueventd    class onboot    criticalservice console /bin/login root    console    user rootservice sntpd /bin/logwrapper /bin/sntpd    user rootservice debuggerd /system/bin/debuggerd    user root    class mainservice crash_manager /bin/logwrapper /bin/crash_manager    user root    group crash_mgr    socket crash_socket dgram 0660 crash_mgr crash_mgr    disabledservice crash_uploader /bin/logwrapper /bin/crash_uploader    user crash_mgr    group crash_mgr    disabledservice dhcpcd /bin/dhcpcd wlan0 eth0 -B --noarp -h harman    class service    user rootservice adbd /sbin/adbd    #disabledservice boot_complete /bin/sh /sbin/boot_complete.sh    class service    oneshot    disabledservice init_complete /bin/sh /system/bin/init_modules.sh    class service    oneshot    disabledservice copy_env /bin/sh /system/bin/copy.sh    class service    oneshot    disabledservice startup_ls6 /bin/sh /system/bin/startup.sh    class service    oneshot    disabledservice dhcpcd_wlan0 /system/bin/dhcpcd -ABKL --noarp -h harman    disabled    oneshotservice iprenew_wlan0 /system/bin/dhcpcd -n    disabled    oneshotservice dhcpcd_p2p /system/bin/dhcpcd -ABKL    disabled    oneshotservice iprenew_p2p /system/bin/dhcpcd -n    disabled    oneshot# DHCPCD# # eth0service dhcpcd_eth0 /system/bin/dhcpcd -ABKL    class main    disabled    oneshot# IP Renew# # eth0service iprenew_eth0 /system/bin/dhcpcd -n    class main    disabled    oneshot# DHCPCD# # eth1service dhcpcd_eth1 /system/bin/dhcpcd -ABKL    class main    disabled    oneshot# IP Renew# # eth1service iprenew_eth1 /system/bin/dhcpcd -n    class main    disabled    oneshotservice dhcpserver /system/bin/dnsmasq -C /data/dhcpserver.conf -x /data/misc/dhcp/dnsmasq.pid    class main    disabled    oneshotservice dnscacher /usr/bin/run-dnscacher.sh    class main    disabled    oneshotservice dhcpservergoolge /system/bin/dnsmasq -C /system/etc/dhcpservergoolge.conf -x /data/misc/dhcp/dnsmasq.pid    class main    disabled    oneshot# sshd executable will be removed from the system image for secure# builds (e.g. user builds) during the signing process.service sshd /bin/logwrapper /usr/sbin/dropbear -r /etc/rsa_host_key -F -E -B    #disabledservice net_mgr /bin/net_mgr    socket net_mgr stream 0660 root net_mgr    class serviceservice watchdog /bin/watchdog -F    socket watchdog stream 0660 root watchdog    class service    oneshot    disabledservice iperf /bin/logwrapper /bin/iperf -s -p 8200 -i 2 -w 128K   oneshotservice iperf_udp /bin/logwrapper /bin/iperf -s -p 8201 -i 2 -u   oneshotservice mdnsd /bin/mdnsd    user mdns    socket mdnsd stream 0660 root mdns#on property:hostapd.enable=1#    start hostapd#on property:hostapd.enable=0#    stop hostapdservice unmute_audio /bin/sh /sbin/unmute_audio.sh    oneshotservice hostapd /system/bin/hostapd /data/wifi/hostapd_ddms.conf    class main    disabled    oneshot#service diversity /system/bin/diversityctrl#    disabled#    oneshotservice wpa_supplicant /bin/wpa_supplicant -Dnl80211 -iwlan0 -c /data/wifi/wpa_supplicant.conf -e/data/wifi/entropy.bin    socket wpa_wlan0 dgram 660 wifi wifi    class serviceservice podium /usr/bin/run-podium.sh    user root